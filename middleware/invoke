#!/bin/sh
#
# Sim2L: opens the landing page bin/coherentmxmetalExample.ipynb, which runs simtool/coherentmxmetal.ipynb
# (torchsim kernel of anaconda-7).
#
/usr/bin/invoke_app "$@" -t coherentmxmetal \
                         -C "start_jupyter -T @tool/bin -t coherentmxmetalExample.ipynb" \
                         -u anaconda-7 \
                         -r none \
                         -w headless
